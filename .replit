modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
EGP_PUBLISHED_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vREnC1DRwCK6eNw37-9p5wmEuDW3mABwEIS3-HJ5_6tiy5AGxdXhk8thTD8oYREcfoB-jA0rJy7yFhL/pub?gid=1875775316&single=true&output=csv"
